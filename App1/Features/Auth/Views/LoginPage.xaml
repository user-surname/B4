<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Features.Auth.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="B4 API Login (JWT)" FontSize="24" FontWeight="SemiBold" />
        <TextBox Grid.Row="2" PlaceholderText="Email" Text="{Binding Email, Mode=TwoWay}" />
        <PasswordBox Grid.Row="4" PasswordChanged="PasswordBox_OnPasswordChanged" />
        <Button Grid.Row="6" Content="Login" Click="LoginButton_OnClick" HorizontalAlignment="Left" />
        <TextBlock Grid.Row="8" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Grid>
</Page>
