<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="B4 WinUI Frontend">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="AppNavView" PaneDisplayMode="Left" IsBackEnabled="False" SelectionChanged="AppNavView_OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LoginNavItem" Content="Login" Tag="Login" Icon="Contact" />
            <NavigationViewItem x:Name="ControllersNavItem" Content="Controllers CRUD" Tag="Controllers" Icon="Library" IsEnabled="False" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
