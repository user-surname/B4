using B4.Api.Dto.GetDto;
using B4.Data.PostgreSQL.Repositories;
using Microsoft.AspNetCore.Mvc;
using System;

namespace B4.Api.Controllers
{
    [ApiController]
    [Route("api/v1/[controller]")]  
    public class DataActualsController : ControllerBase
    {
        private readonly DataActualsRepository _actualsRepo;
        public DataActualsController(DataActualsRepository actualsRepo)
        {
            _actualsRepo = actualsRepo;
        }

        // GET /api/v1/actuals/{planta}/{ejercicio}/{epigrafe}
        [HttpGet("{planta:int}/{ejercicio:int}/{epigrafe:int}")]
        public IActionResult GetActualsByPlantaEjercicioEpigrafe(int planta, int ejercicio, int epigrafe)
        {
            try
            {
                // Obtener registros filtrados desde el repositorio (consulta optimizada por campos ID)
                var records = _actualsRepo.GetByPlantaEjercicioEpigrafe(planta, ejercicio, epigrafe);
                // Construir la cabecera (head) con datos comunes
                var head = new DataActualsHeadDto
                {
                    ts = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss.fff"),  // timestamp actual
                    p = planta.ToString(),
                    e = ejercicio,
                    c = records.FirstOrDefault()?.IdCiclo ?? 0,   // ciclo (idciclo, asumir 0 si actuals)
                    f = records.FirstOrDefault()?.IdFase.ToString() ?? "0",  // fase (idfase, como string)
                    m = /* mapear a código moneda */ GetCurrencyCode(records.FirstOrDefault()?.IdCurrency ?? 0)
                };
                // Construir la lista de detalles
                var detailList = records.Select(r => new DataActualsDetailDto 
                {
                    e = r.IdEpigrafe,
                    v = new decimal[] { 
                        r.Mes00, r.Mes01, r.Mes02, r.Mes03, r.Mes04, r.Mes05, r.Mes06, 
                        r.Mes07, r.Mes08, r.Mes09, r.Mes10, r.Mes11, r.Mes12, r.Mes13 
                    }
                }).ToList();
                // Armar el DTO de respuesta
                var dataDto = new DataActualsGetDto { head = head, detail = detailList };
                return Ok(dataDto); // Se envía solo el objeto de datos; el middleware lo envolverá con metadata
            }
            catch (Exception ex)
            {
                // Manejo de error: devolverá control al middleware que formateará el mensaje
                return BadRequest(ex.Message);
            }
        }

        // Método auxiliar para obtener código de moneda a partir del id (ejemplo simple)
        private string GetCurrencyCode(int idCurrency)
        {
            // Supongamos un mapeo fijo conocido de idCurrency a código (esto podría provenir de un servicio/tabla)
            return idCurrency == 0 ? "PLN" : "EUR"; // Ejemplo: 0->PLN, otro->EUR (ajustar según realidad)
        }
                // POST /api/v1/actuals/{planta}/{ejercicio}/{mes}/{tipo}
        [HttpPost("{planta:int}/{ejercicio:int}/{mes:int}/{tipo}")]
        public IActionResult PostActualsByPlantaEjercicio(int planta, int ejercicio, int mes, string tipo, [FromBody] DataActualsPostDto[] nuevosActuals)
        {
            if (nuevosActuals == null || nuevosActuals.Length == 0)
                return BadRequest("El cuerpo de la petición está vacío o no tiene elementos.");
            try
            {
                // Preparar valores comunes para todos los registros
                int idCiclo = 0; 
                int idFase = 0;
                int idCurrency = DeterminarMoneda(planta, tipo); // e.g., determina id moneda según planta o tipo
                Guid guidCarga = Guid.NewGuid();
                DateTime fechaActual = DateTime.Now;
                
                int filasInsertadas = 0;
                foreach (var item in nuevosActuals)
                {
                    // Crear entidad DataActuals con datos combinando ruta y cuerpo
                    var entity = new DataActuals 
                    {
                        IdCompany = planta,
                        Ejercicio = ejercicio,
                        IdCiclo = idCiclo,
                        IdFase = idFase,
                        IdCurrency = idCurrency,
                        IdEpigrafe = item.e,
                        // Asignar los 13 valores de meses, mes00 se puede calcular o dejar 0
                        Mes00 = 0, // Suponemos mes00 como 0 o podría representar un acumulado inicial
                        Mes01 = item.m1, Mes02 = item.m2, Mes03 = item.m3, Mes04 = item.m4,
                        Mes05 = item.m5, Mes06 = item.m6, Mes07 = item.m7, Mes08 = item.m8,
                        Mes09 = item.m9, Mes10 = item.m10, Mes11 = item.m11, Mes12 = item.m12,
                        Mes13 = item.m13,
                        // Metadatos de carga
                        IdAPICarga = 1,              // Id de la API que carga (por ejemplo, 1)
                        GuidCarga = guidCarga,       // mismo Guid para todas las filas de esta carga
                        FechaUltModif = fechaActual
                    };
                    _actualsRepo.AddAsync(entity);  // Inserta usando Dapper (retorna el nuevo Id en entity.Id)
                    filasInsertadas++;
                }

                // Opcionalmente, devolver información de inserción en data
                var resultData = new { inserted = filasInsertadas };
                return Ok(resultData);
            }
            catch (Exception ex)
            {
                return StatusCode(500, ex.Message);
            }
        }

        // Método auxiliar para determinar IdCurrency según tipo o planta
        private int DeterminarMoneda(int planta, string tipo)
        {
            // Lógica simple: si tipo coincide con un código de moneda, usarlo; si no, moneda local por defecto.
            // (En un caso real, consultaría una tabla de monedas. Aquí, si tipo == "EUR", devolvemos id EUR, sino id por defecto de planta)
            if (tipo.Equals("EUR", StringComparison.OrdinalIgnoreCase))
                return /* id moneda EUR */ 2;
            else
                return /* id moneda local de la planta */ 1;
        }
    }
}

