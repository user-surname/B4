<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="B4.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="B4 WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Margin="8,4,4,4"
                Click="PaneToggleButton_Click"
                ToolTipService.ToolTip="Toggle navigation">
                <SymbolIcon Symbol="GlobalNavigationButton" />
            </Button>

            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="B4 Frontend" />

            <StackPanel
                Grid.Column="3"
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Button x:Name="DonateButton" Click="DonateButton_Click" ToolTipService.ToolTip="Donate to Support Development">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB52;" />
                        <TextBlock Text="Donate" />
                    </StackPanel>
                </Button>
                <Button x:Name="BugButton" Click="BugButton_Click" ToolTipService.ToolTip="Report a Bug">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA39;" />
                        <TextBlock Text="Bug" />
                    </StackPanel>
                </Button>
                <Button x:Name="DocsButton" Click="DocsButton_Click" ToolTipService.ToolTip="Documentation">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Help" />
                        <TextBlock Text="Docs" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SidebarPanel"
                Grid.Column="0"
                Margin="8"
                Width="220"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="14,14,14,10"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Navigation" />

                    <StackPanel Grid.Row="1" Margin="10,0,10,0" Spacing="6">
                        <Button x:Name="LoginNavButton" Click="LoginNavButton_Click" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Contact" />
                                <TextBlock x:Name="LoginNavText" Text="Login" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ControllersNavButton" Click="ControllersNavButton_Click" HorizontalContentAlignment="Left" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Library" />
                                <TextBlock x:Name="ControllersNavText" Text="Controllers CRUD" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,6,10,10" Spacing="6">
                        <Button x:Name="SettingsNavButton" Click="SettingsNavButton_Click" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock x:Name="SettingsNavText" Text="Settings" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Click="MoreButton_Click" HorizontalContentAlignment="Left">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open Logs" Click="LogsMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Document" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Open Scripts" Click="ScriptsMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE943;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Close App" Click="CloseAppMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Cancel" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="More" />
                                <TextBlock x:Name="MoreNavText" Text="More" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" Margin="0,8,8,8" />
        </Grid>
    </Grid>
</Window>
