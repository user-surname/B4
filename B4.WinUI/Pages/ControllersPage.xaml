<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="B4.WinUI.Pages.ControllersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dataGrid="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid Padding="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <SymbolIcon Symbol="Library" />
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="Controllers CRUD" />
                <TextBlock Opacity="0.75" Text="Adapted visual shell from Winhance + App1 layout." />
            </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,14,0,14"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock Text="Install Selected Items" />
                </StackPanel>
            </Button>
            <Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="Uninstall Selected Items" />
                </StackPanel>
            </Button>
            <Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Help" />
                    <TextBlock Text="Help" />
                </StackPanel>
            </Button>
            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        x:Name="TableViewToggle"
                        IsChecked="True"
                        Checked="TableViewToggle_Checked"
                        Unchecked="TableViewToggle_Unchecked"
                        BorderThickness="0"
                        Background="Transparent"
                        CornerRadius="4,0,0,4"
                        ToolTipService.ToolTip="Table View">
                        <FontIcon Glyph="&#xF0E2;" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="CardViewToggle"
                        Checked="CardViewToggle_Checked"
                        Unchecked="CardViewToggle_Unchecked"
                        BorderThickness="0"
                        Background="Transparent"
                        CornerRadius="0,4,4,0"
                        ToolTipService.ToolTip="Card View">
                        <SymbolIcon Symbol="AllApps" />
                    </ToggleButton>
                </StackPanel>
            </Border>
            <AutoSuggestBox Width="220" PlaceholderText="Search controllers..." QueryIcon="Find" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8"
                Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="CRUD Actions" />
                    <ComboBox
                        PlaceholderText="Selecciona un controller"
                        ItemsSource="{Binding Endpoints}"
                        SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                        DisplayMemberPath="ControllerName" />
                    <TextBox Header="Id" PlaceholderText="Ej. 15" Text="{Binding GetByIdText, Mode=TwoWay}" />
                    <Button Content="Get All" Click="GetAll_OnClick" />
                    <Button Content="Get By Id" Click="GetById_OnClick" />
                    <Button Content="Delete" Click="Delete_OnClick" />
                    <TextBox
                        AcceptsReturn="True"
                        Header="Create JSON Body"
                        Height="180"
                        Text="{Binding CreateJson, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <Button Content="Create" Click="Create_OnClick" />
                    <TextBlock Opacity="0.7" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8"
                Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <dataGrid:DataGrid
                        x:Name="ResultsGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        ItemsSource="{Binding TableRows}" />

                    <TextBox
                        x:Name="RawResultBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="110"
                        TextWrapping="Wrap"
                        Text="{Binding ResultJson}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
