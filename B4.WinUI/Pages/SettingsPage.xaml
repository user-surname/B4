<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="B4.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <SymbolIcon Symbol="Setting" />
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="Settings" />
                <TextBlock Opacity="0.75" Text="Winhance-inspired settings layout (visual)." />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="General" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Language" />
                            <TextBlock Opacity="0.7" Text="Choose your preferred display language." />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Español" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Theme" />
                            <TextBlock Opacity="0.7" Text="Switch app appearance style." />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="System default" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Configuration" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Backup &amp; Restore" />
                            <TextBlock Opacity="0.7" Text="Save or import configuration snapshots." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Backup Configuration" />
                                <Button Content="Restore Configuration" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
